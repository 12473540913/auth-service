# Copy to .env.development for local work. In Cloud Run these are set as service
# environment variables, with every secret sourced from Secret Manager.

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# The stage this instance serves. Clients cannot override it, so a prod service
# can only ever reach prod databases.
AUTH_ENV=dev
NODE_ENV=development

# Cloud Run injects PORT automatically; only set it locally.
PORT=8080

# ---------------------------------------------------------------------------
# Tokens
# ---------------------------------------------------------------------------
# Minimum 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Cookies (browser apps only)
# ---------------------------------------------------------------------------
AUTH_COOKIE_NAME=auth_session
AUTH_COOKIE_SECURE=true

# Default SameSite for every app; override per app with AUTH_COOKIE_SAMESITE_<APP>.
# Apps under *.lnks.info are same-site with the auth service, so lax works and keeps
# CSRF protection. Only an app on an unrelated domain needs none (which requires Secure).
AUTH_COOKIE_SAMESITE=lax

# Optional per-app cookie Domain, e.g. AUTH_COOKIE_DOMAIN_FINANCES=.lnks.info, so the
# session cookie is shared across a web frontend and its API on different subdomains.
# Unset means host-only (visible only to the exact host that set it).

# ---------------------------------------------------------------------------
# Registered apps
# ---------------------------------------------------------------------------
# Only ids listed here are accepted in the X-App-Id header. Adding an app means
# adding it to this list plus its MONGODB_URI_* entry below.
AUTH_APP_IDS=spice,finances

# --- spice (Electron desktop client, MongoDB Atlas) -------------------------
AUTH_APP_NAME_SPICE=Spice
# Electron has no usable cross-site cookie jar, so it uses Authorization: Bearer.
AUTH_TOKEN_MODE_SPICE=bearer
# No browser origins: requests come from the Electron main process with no Origin header.
AUTH_ORIGINS_SPICE=
AUTH_FEATURES_SPICE=entry-status
ATLAS_URI_SPICE=

# --- finances (web app, Neon Postgres) --------------------------------------
AUTH_APP_NAME_FINANCES=Finances
AUTH_TOKEN_MODE_FINANCES=cookie
# dev now:  https://auth-dev-46917854791.us-central1.run.app <- http://localhost:5173
# dev later: https://auth-dev.lnks.info                       <- http://localhost:5173
# prod:      https://auth.lnks.info                           <- https://finances.lnks.info
AUTH_ORIGINS_FINANCES=http://localhost:5173
# AUTH_ORIGINS_FINANCES=https://finances.lnks.info
# Temporary run.app dev auth is cross-site for browser apps; switch back to lax when
# finances dev uses auth-dev.lnks.info under the same registrable domain.
AUTH_COOKIE_SAMESITE_FINANCES=none
# Shares the session cookie with api.finances.lnks.info so that API can verify it locally.
# AUTH_COOKIE_DOMAIN_FINANCES=.lnks.info
# entry-status is mongodb-only and rejected at boot on a postgres tenant.
AUTH_FEATURES_FINANCES=
# Must be the EXACT SAME connection string as finances' own DATABASE_URL (its
# database/schema.sql), so users/profiles live in finances' own Neon database rather
# than a separate shared auth database.
NEON_URI_FINANCES=

# ---------------------------------------------------------------------------
# Database tuning
# ---------------------------------------------------------------------------
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
PG_CONNECTION_TIMEOUT_MS=5000
# Neon caps concurrent connections and Cloud Run runs many instances, so keep this small.
PG_MAX_POOL_SIZE=5

# ---------------------------------------------------------------------------
# Email (Resend). If unset, verification codes are logged as skipped instead of sent.
# ---------------------------------------------------------------------------
RESEND_FULL_ACCESS_KEY=
RESEND_FROM=
