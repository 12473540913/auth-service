# Copy to .env.development for local work. In Cloud Run these are set as service
# environment variables, with every secret sourced from Secret Manager.

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# The stage this instance serves. Clients cannot override it, so a prod service
# can only ever reach prod databases.
AUTH_ENV=dev
NODE_ENV=development

# Cloud Run injects PORT automatically; only set it locally.
PORT=8080

# ---------------------------------------------------------------------------
# Tokens
# ---------------------------------------------------------------------------
# Minimum 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Cookies (browser apps only)
# ---------------------------------------------------------------------------
AUTH_COOKIE_NAME=auth_session
AUTH_COOKIE_SECURE=true

# Default SameSite for every app; override per app with AUTH_COOKIE_SAMESITE_<APP>.
# Apps under the same registrable domain as the auth service are same-site, so lax works
# and retains CSRF protection. Only an app on an unrelated domain needs none (requires Secure).
AUTH_COOKIE_SAMESITE=lax

# Optional per-app cookie Domain to share a session cookie across related subdomains.
# Unset means host-only (visible only to the exact host that set it).

# ---------------------------------------------------------------------------
# Registered apps
# ---------------------------------------------------------------------------
# Only IDs listed here are accepted in the X-App-Id header. Replace "example" with your
# tenant ID, then use that ID (normalized to uppercase) in the variable suffixes below.
AUTH_APP_IDS=example

# Choose the token mode appropriate for this tenant's clients: cookie or bearer.
AUTH_APP_NAME_EXAMPLE=Example
AUTH_TOKEN_MODE_EXAMPLE=cookie
AUTH_ORIGINS_EXAMPLE=http://localhost:5173
AUTH_COOKIE_SAMESITE_EXAMPLE=lax
AUTH_FEATURES_EXAMPLE=
# Use the URI prefix matching the database provider; driver selection follows its URI scheme.
DATABASE_URI_EXAMPLE=

# ---------------------------------------------------------------------------
# Database tuning
# ---------------------------------------------------------------------------
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
PG_CONNECTION_TIMEOUT_MS=5000
# Managed Postgres services may cap concurrent connections, so keep this pool small.
PG_MAX_POOL_SIZE=5

# ---------------------------------------------------------------------------
# Email (Resend). If unset, verification codes are logged as skipped instead of sent.
# ---------------------------------------------------------------------------
RESEND_FULL_ACCESS_KEY=
RESEND_FROM=
